[Unit]
Description=Autonomous TinyML Edge-Security Gateway Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/fyp1512
ExecStart=/usr/bin/python3 /home/fyp1512/dashboard.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
